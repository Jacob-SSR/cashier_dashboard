# คัดลอกไฟล์นี้เป็น .env.production ก่อนรัน docker compose up
#   cp .env.example .env.production

# ── ฐานข้อมูล HOSxP (MySQL) ────────────────────────────────
# ถ้ายังไม่ตั้ง 4 ค่านี้ครบ ระบบจะรัน "โหมดสาธิต" (ข้อมูลตัวอย่าง) ให้ดูหน้าจอได้ก่อน
# HOSxP รันบนเครื่อง host เดียวกับ docker → ใช้ host.docker.internal
# HOSxP อยู่คนละเครื่องในวง LAN → ใส่ IP จริง เช่น 192.168.1.10
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=hos

# ── ขนาด connection pool (ไม่ตั้งก็ได้ ใช้ค่า default) ─────
# DB_POOL_SIZE=8
# DB_POOL_IDLE=4
# DB_QUEUE_LIMIT=100

# ── เกณฑ์ว่าใครขึ้นจอ ──────────────────────────────────────
# all     = ทุกคนที่อยู่ห้องเก็บเงินตอนนี้ (ค่าเริ่มต้น) — ไม่แตะตารางการเงินเลย
#           จ่ายเสร็จ HOSxP ย้าย cur_dep ออกเอง แถวนั้นก็หลุดจากจอ
# charges = เฉพาะคนที่มีค่าใช้จ่ายและยังไม่ปิดยอด (opitemrece)
# bill    = เฉพาะคนที่มีบิลใน opd_opi_finance_summary และยังไม่ถูกเคลียร์
# selfpay = เฉพาะคนที่ต้องควักเงินจ่ายเอง (สิทธิ์ paidst 01 + 03)
#
# เริ่มด้วย all ให้เห็นชื่อก่อน แล้วค่อยไล่กรองให้แคบลงทีละขั้น
# ถ้าเกณฑ์ที่ตั้งไม่ได้คนเลย ระบบจะถอยไปใช้เกณฑ์ที่หลวมกว่าให้เอง (จอไม่ว่าง)
# 👉 เปิด http://<ip>:4500/api/queue/debug ดูตัวเลขเทียบกันได้
QUEUE_SOURCE=all

# ── รหัสแผนกห้องเก็บเงิน (kskdepartment.depcode) ───────────
# 013 = "ห้องเก็บเงิน" ของ รพ.พลับพลาชัย (ยืนยันจากตาราง kskdepartment แล้ว)
# จอจะเอาเฉพาะคนที่ HosXP ส่งมาอยู่ห้องเก็บเงินตอนนี้ และ "เวลาส่ง" จะเป็น
# เวลาที่ถูกส่งมาห้องเก็บเงินจริง ๆ
# ตั้งเป็นค่าว่างเพื่อปิดตัวกรองนี้ (จะเห็นผู้ป่วยนอกทุกคนของวันนี้แทน)
#
# ★ 013,077,078 = ชุดเดียวกับที่จอเดิมส่งเข้า ajax (ดู moneyAndDrug.php บรรทัด 291-292)
#   ห้องเก็บเงินมีหลายจุดบริการ ถ้าใส่แค่ 013 จะขาดคนของอีก 2 จุด
CASHIER_DEP_CODES=013,077,078

# ── สัญญาณ "เรียกคิวแล้ว" (ไม่มี env ให้ตั้ง — ทำงานเสมอ) ──
# ทั้ง "เรียกคิว" และ "คิวรอ" อ่านจากตาราง sd_queue_calling ตามจอเดิมเป๊ะ ๆ
#   เรียกคิว = 2 แถวล่าสุดของวันนี้ (ORDER BY sd_queue_calling_datetime DESC)
#   คิวรอ    = คนที่ cur_dep อยู่ห้องเก็บเงิน และ "ยังไม่เคยถูกเรียก"
#              (sd_queue_calling_datetime IS NULL OR cur_dep_time >= TIME(datetime))
# จอนี้อ่านอย่างเดียว ไม่ UPDATE sd_queue_calling_status เหมือนจอเดิม
# จะได้ไม่แย่งกันกับจอเดิมตอนรันคู่กัน

# ── ชื่อสถานะ (ovstost) ที่ถือว่าออกจากระบบแล้ว → ตัดออกจากจอ ──
# ค่าเริ่มต้นครอบคลุมของ รพ. แล้ว: หนีกลับ, ปฏิเสธการรักษา, เสียชีวิต, ตายที่,
# ส่งต่อ, Admit ฯลฯ  ⚠️ ห้ามใส่คำว่า "แล้ว" จะไปตัด "ตรวจแล้ว" ที่ยังต้องจ่ายเงิน
# FINISHED_STATUS=หนีกลับ,ปฏิเสธการรักษา,เสียชีวิต,ตายที่,ส่งต่อ,Admit

# ── กันคนค้างบนจอทั้งวัน (นาที) ────────────────────────────
# ปิดไว้ (0) เป็นค่าเริ่มต้น เพราะ sd_queue_calling ตัดคนที่ถูกเรียกไปแล้วให้อยู่แล้ว
# และจอเดิมก็ไม่มีตัวตัดเวลานี้ — ตั้ง 240 ถ้าอยากเปิดตาข่ายกันเหนียวไว้ด้วย
QUEUE_MAX_AGE_MINUTES=0

# ── หน้าจอ ─────────────────────────────────────────────────
# ชื่อที่ขึ้นหัวจอคิว
BOARD_TITLE=ห้องเก็บเงินโรงพยาบาลพลับพลาชัย
# ชื่อ รพ. ที่ขึ้นบนจอเรียกชื่อ (/display)
HOSPITAL_NAME=โรงพยาบาลพลับพลาชัย
# ระยะรีเฟรชอัตโนมัติ (วินาที)
REFRESH_SECONDS=15

# ── เสียงประกาศเรียกคิว ────────────────────────────────────
# ใส่แค่ "บางส่วนของชื่อเสียง" ก็พอ เทียบแบบไม่สนตัวพิมพ์เล็ก/ใหญ่
# ชื่อเสียงขึ้นกับ OS ของ "เครื่องที่ต่อกับจอ TV" ไม่ใช่เครื่อง server:
#   Apple (iPad/Mac/Safari)   → Siri, Kanya
#   Windows (Chrome/Edge)     → Premwadee, Pattara, Narisa
#   Android / Chrome OS       → เสียงไทยของ Google
# ถ้าหาเสียงที่ตั้งไว้ไม่เจอ ระบบจะไล่หาเสียงไทยตัวอื่นให้เอง (ไม่เงียบ)
#
# 👉 เปิด http://<ip>:4500/voices บนเครื่องที่ต่อจอ เพื่อดูว่ามีเสียงอะไรบ้าง
#    และกดฟังตัวอย่างได้เลย  ลองสลับสดบนจอด้วย /?voice=premwadee ก็ได้
TTS_VOICE=Siri

# ── ความเร็ว/ข้อความประกาศ ─────────────────────────────────
# ปรับได้โดยไม่ต้องแก้โค้ด แก้แล้ว docker compose up -d --force-recreate
#
# ความเร็ว: 1.0 = ปกติ, ต่ำกว่า = ช้าลง  (จอ รพ. ใช้ 0.7 ให้ผู้สูงอายุฟังทัน)
# ต่ำกว่า 0.5 เสียงจะเริ่มยาน ฟังไม่รู้เรื่อง ระบบจึงล็อกช่วงไว้ที่ 0.5-2.0
TTS_RATE=0.7

# ระดับเสียงสูง-ต่ำ 1.0 = ปกติ (ต่ำลง = ทุ้มขึ้น)
TTS_PITCH=1.0

# พูดกี่รอบต่อการเรียก 1 ครั้ง (คั่นแต่ละรอบด้วยจังหวะหยุดหายใจให้เอง)
TTS_REPEAT=2

# ข้อความประกาศ — {ชื่อ} จะถูกแทนด้วยชื่อคนไข้
# ไม่ต้องใส่ "ค่ะ/ครับ" ก็ได้ ตัดออกแล้วประโยคจบคมกว่า ฟังชัดกว่าจากท้ายห้อง
TTS_TEXT=เชิญ {ชื่อ} ชำระเงินที่ห้องเก็บเงิน

# ประโยคปิดท้าย พูดครั้งเดียวหลังเรียกชื่อครบทุกรอบ (ตั้งว่างไว้ = ไม่พูด)
TTS_THANKS=ขอบคุณค่ะ

# 👉 ลองสดบนจอก่อนตั้งจริงได้ ต่อท้าย URL ได้เลย ไม่ต้อง restart:
#    http://<ip>:4500/?rate=0.6&repeat=3
#    http://<ip>:4500/?say=เชิญ {ชื่อ} ที่ช่องชำระเงิน
#    http://<ip>:4500/?thanks=ขอบคุณครับ
#
# ⚠️ เสียงจะออกเองก็ต่อเมื่อเปิดจอด้วย scripts\start-tv.bat
#    (Chrome ไม่ยอมส่งเสียงจนกว่าจะมีคนคลิก ทีวีไม่มีเมาส์จึงต้องใช้แฟลกปิดกฎนั้น)
# จำนวนแถวใน "คิวรอ" (ไม่นับคนที่อยู่ในส่วน "เรียกคิว" ด้านบน)
BOARD_ROWS=10
# แบ่งเป็นช่อง ช่องละกี่คิว — 10 ÷ 5 = 2 ช่อง (ความสูงแถวปรับให้เองอัตโนมัติ)
BOARD_ROWS_PER_COLUMN=5

# ── บังคับโหมดสาธิตแม้ตั้ง DB ครบ (ใช้ตอนสาธิต/อบรม) ──────
# DEMO_MODE=1

TZ=Asia/Bangkok
