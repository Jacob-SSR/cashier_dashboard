# คัดลอกไฟล์นี้เป็น .env.production ก่อนรัน docker compose up
#   cp .env.example .env.production

# ── ฐานข้อมูล HOSxP (MySQL) ────────────────────────────────
# ถ้ายังไม่ตั้ง 4 ค่านี้ครบ ระบบจะรัน "โหมดสาธิต" (ข้อมูลตัวอย่าง) ให้ดูหน้าจอได้ก่อน
# HOSxP รันบนเครื่อง host เดียวกับ docker → ใช้ host.docker.internal
# HOSxP อยู่คนละเครื่องในวง LAN → ใส่ IP จริง เช่น 192.168.1.10
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=hos

# ── ขนาด connection pool (ไม่ตั้งก็ได้ ใช้ค่า default) ─────
# DB_POOL_SIZE=8
# DB_POOL_IDLE=4
# DB_QUEUE_LIMIT=100

# ── รหัสแผนก "ห้องเก็บเงิน" (kskdepartment.depcode) ────────
# ตั้งแล้วระบบจะจับคิวจากแผนกนี้โดยตรง — ดูวิธีหารหัสใน docs/sql/cashier_queue.sql
# ไม่ตั้ง = ใช้เกณฑ์กลาง: visit ของวันนี้ที่มียอดเงิน (income > 0)
# CASHIER_DEP_CODES=

# ── หน้าจอ ─────────────────────────────────────────────────
HOSPITAL_NAME=โรงพยาบาลพลับพลาชัย
# ระยะรีเฟรชอัตโนมัติ (วินาที)
REFRESH_SECONDS=15
# จำนวนคิวที่แสดงบนจอ TV (/tv) — ตั้งไว้ 10 พอดีจอ 55 นิ้ว 1080p
TV_ROWS=10
# แบ่งเป็นช่อง ช่องละกี่คิว — 10 ÷ 5 = 2 ช่อง (ความสูงแถวปรับให้เองอัตโนมัติ)
TV_ROWS_PER_COLUMN=5

# ── บังคับโหมดสาธิตแม้ตั้ง DB ครบ (ใช้ตอนสาธิต/อบรม) ──────
# DEMO_MODE=1

TZ=Asia/Bangkok
